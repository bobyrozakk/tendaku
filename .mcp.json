{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "excel": {
            "command": "uvx",
            "args": [
                "excel-mcp-server",
                "stdio",
                "--allow-dir",
                "/path/to/workbooks"
            ]
        }
    }
}