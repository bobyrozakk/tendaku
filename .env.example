APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tendaku
DB_USERNAME=tendaku_user
DB_PASSWORD=tendaku

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=

# Monetisasi platform (opsional; nilai di bawah adalah default)
MONETIZATION_COMMISSION_RATE=0.05
MONETIZATION_COMMISSION_MINIMUM=2500
MONETIZATION_QRIS_MDR_THRESHOLD=100000
MONETIZATION_QRIS_MDR_RATE_BELOW=0.0
MONETIZATION_QRIS_MDR_RATE_ABOVE=0.007
MONETIZATION_TRANSFER_FEE=3500
MONETIZATION_MINIMUM_PAYOUT=50000

# Notifikasi WhatsApp (Fonnte) & pengingat pengembalian barang
# Kanal: whatsapp | in_app | email
NOTIFICATION_CHANNEL=whatsapp
# PENTING: token Fonnte = nilai rahasia. Isi di file .env (tidak di-commit),
# file .env.example HANYA placeholder kosong. Regenerate token di dashboard
# Fonnte bila pernah ikut terisi di sini.
FONNTE_TOKEN=
FONNTE_BASE_URL=https://api.fonnte.com
FONNTE_TIMEOUT=10
FONNTE_RETRY_TIMES=2
FONNTE_RETRY_SLEEP_MS=300
REMINDER_ENABLED=true
REMINDER_HOUR=9
REMINDER_TIMEZONE=Asia/Jakarta
REMINDER_INCLUDE_ITEM_LIST=true
REMINDER_INCLUDE_LATE_FEE=true

# Praktikiraan cuaca (Open-Meteo — gratis, tanpa API key)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEZONE=Asia/Jakarta
WEATHER_TIMEOUT=10
WEATHER_RETRY_TIMES=2
WEATHER_RETRY_SLEEP_MS=300
WEATHER_CACHE_TTL=30